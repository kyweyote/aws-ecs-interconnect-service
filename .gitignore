# Terraform working directory
.terraform/
.terraform.lock.hcl

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan
*.plan

# Terraform variable files (often contain secrets)
*.tfvars
*.tfvars.json

# Terraform lock and crash logs
.terraform.tfstate.lock.info
crash.log
crash.*.log

# CLI config files
terraform.rc
.terraformrc

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local environment files
.env
.env.*

# OS/editor files
.DS_Store
.vscode/
.idea/
